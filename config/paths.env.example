# Local code/data roots. Source this file from a launcher only after copying it
# to config/paths.env and adapting hardware-specific values.
export NERO_CONTROL_ROOT=/home/dev/nero_bimanual_control
export NERO_TELEOP_ROOT=/home/dev/nero_neo_teleop
export NERO_DATA_ROOT=/home/dev/nero_data

# Official AgiBot SDK remains an external dependency for now.
export NERO_ARM_SDK_ROOT=/home/dev/nero_ws/src/pyAgxArm

# Checkpoints and the OpenPI service are maintained on the training server.
export NERO_POLICY_SERVER=172.24.1.154
export NERO_POLICY_PORT=8000
